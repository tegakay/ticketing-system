DATABASE_URL="postgresql://user:password@localhost:5432/ticketing"
PORT=3000

JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

STRIPE_SECRET_KEY="sk_test_replace_me"
# HMAC-SHA256 key the payment provider signs webhooks with. Webhooks are rejected (503) without it.
PAYMENT_WEBHOOK_SECRET="whsec_replace_me"

# Optional: if Redis is unreachable the API falls back to Postgres-only mode.
REDIS_URL="redis://localhost:6379"

# Integration tests only (see docker-compose.test.yml)
DATABASE_URL_TEST="postgresql://test:test@localhost:5433/ticketing_test"
REDIS_URL_TEST="redis://localhost:6380"
